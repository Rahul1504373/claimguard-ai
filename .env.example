# Get this from Google AI Studio (https://aistudio.google.com/apikey)
# IMPORTANT: keep billing DISABLED on this project/key if you want the
# hard $0 safety net described in our cost-safety plan — exceeding the
# free tier then just returns 429 errors instead of charging you.
GEMINI_API_KEY=your_api_key_here

# Model tiers — swap to your available model names if these change
EXTRACTION_MODEL=gemini-3.5-flash-lite
CONSISTENCY_MODEL=gemini-3.5-flash
EXPLAINABILITY_MODEL=gemini-3.5-flash

# Local storage file (used when USE_FIRESTORE=false — the pytest default)
CLAIMS_STORE_PATH=data/claims_store.json

# Set to true to use Firestore instead of the local JSON file.
# For $0 local testing against real Firestore behavior, run the emulator
# (free, part of the Firebase CLI) and point at it:
#   firebase emulators:start --only firestore
#   export FIRESTORE_EMULATOR_HOST=localhost:8080
# When deployed to Cloud Run with USE_FIRESTORE=true and no emulator host
# set, it talks to real Firestore within the free Spark-tier quota.
USE_FIRESTORE=false

# --- Security settings (all free) ---
# Shared-secret API key. Leave EMPTY for local dev/testing (auth disabled).
# Before any deployment beyond your own machine, generate a real one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and set it here AND in the Streamlit dashboard's API_KEY env var so it can
# still call the API. Send it as header: X-API-Key: <value>
CLAIMGUARD_API_KEY=

# Comma-separated list of allowed frontend origins for CORS. Never use "*".
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate limit for claim submission, per client IP (slowapi syntax)
RATE_LIMIT_SUBMIT=10/minute
RATE_LIMIT_LOGIN=10/minute

# --- RBAC settings (all free — see app/auth.py's module docstring for the
# honest scope: 5 fixed demo accounts, no signup flow, no key rotation) ---
# MUST be overridden with a real random value for anything beyond your own
# machine: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=120
# Auto-seeded with 5 demo users (one per role) on first run if this file
# doesn't exist yet — see README.md for the demo username/password list.
USERS_STORE_PATH=data/users.json
